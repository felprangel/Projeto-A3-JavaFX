<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="661.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.projetoa3.projetoa3.ToDoController">
    <stylesheets>
        <URL value="@todo.css" />
    </stylesheets>
   <children>
      <TextField fx:id="taskInput" layoutX="159.0" layoutY="146.0" prefHeight="26.0" prefWidth="291.0" styleClass="textinput" stylesheets="@todo.css" />
      <Button layoutX="452.0" layoutY="139.0" mnemonicParsing="false" onAction="#addTask">
         <graphic>
            <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@icons8-adicionar-32.png" />
               </image>
            </ImageView>
         </graphic></Button>
      <Pane layoutX="156.0" layoutY="14.0" prefHeight="116.0" prefWidth="351.0" styleClass="pane" stylesheets="@todo.css">
         <children>
            <Circle fill="#e64f00" layoutX="280.0" layoutY="58.0" radius="50.0" stroke="TRANSPARENT" strokeType="INSIDE" strokeWidth="0.0" />
            <Label fx:id="taskCount" layoutX="287.0" layoutY="36.0" text="0" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="31.0" />
               </font>
            </Label>
            <Label layoutX="256.0" layoutY="36.0" text="0" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="31.0" />
               </font>
            </Label>
            <Label layoutX="274.0" layoutY="36.0" text="/" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="31.0" />
               </font>
            </Label>
            <Label fx:id="taskCount1" layoutX="43.0" layoutY="36.0" text="ToDo" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="31.0" />
               </font>
            </Label>
         </children></Pane>
      <ScrollPane layoutX="143.0" layoutY="186.0" prefHeight="200.0" prefWidth="365.0" styleClass="mainTasks" stylesheets="@todo.css">
        <content>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="200.0" prefWidth="373.0" styleClass="mainTasks" stylesheets="@todo.css">
               <children>
                  <VBox fx:id="taskListContainer" layoutX="7.0" prefHeight="200.0" prefWidth="342.0" styleClass="mainTasks" stylesheets="@todo.css">
                  </VBox>
               </children>
            </AnchorPane>
        </content>
      </ScrollPane>
   </children>

</AnchorPane>
